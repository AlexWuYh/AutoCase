# Backend environment template. Copy to .env and adjust before starting.
# Application
APP_NAME=AutoCase Platform
DEBUG=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Secret key MUST be replaced with a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-change-me-please-32chars

# Database
DATABASE_URL=sqlite:///./data/autocase.db

# Initial admin (created on first run when no users exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_EMAIL=admin@autocase.example

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
