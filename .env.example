# Copy to .env at project root and adjust values.

# ──── App ────
APP_NAME=AutoCase Platform
DEBUG=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ──── Security ────
# REQUIRED: a long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-to-a-long-random-string-min-32-chars

# ──── Database ────
DATABASE_URL=sqlite:///./data/autocase.db

# ──── Initial admin (auto-created on first run) ────
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_EMAIL=admin@autocase.example

# ──── Celery / Redis ────
# Inside docker-compose, the host is the service name "redis".
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ──── Uploads ────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
